    "@noble/hashes": "^2.4.0",
    "@uiw/react-codemirror": "^4.25.11",
    "axios": "1.18.1",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "cn": "^0.5.0",
    "i18next": "^26.3.6",
    "motion": "^12.42.2",
    "radix-ui": "1.8.1",
    "react": "^19.2.7",
